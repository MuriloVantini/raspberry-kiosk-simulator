# Endereço da API Laravel do mobile2screen
M2S_API_BASE_URL=http://localhost:8000

# Porta local que representa o Raspberry Pi/TV.
KIOSK_PORT=3333

# Opcional: URL pública fixa usada pelo QR Code. Se ausente, o IP da rede local é detectado.
# KIOSK_PUBLIC_URL=http://192.168.1.50:3333

# Frequência de consulta de novos alertas.
POLL_INTERVAL_MS=3000
HEARTBEAT_INTERVAL_MS=15000

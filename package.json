{
  "name": "mobile2screen-raspberry-kiosk-simulator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "build": "tsc -b && vite build",
    "dev": "vite --host 0.0.0.0",
    "dev:server": "cross-env KIOSK_PORT=3334 KIOSK_PUBLIC_PORT=3333 node --watch server.mjs",
    "tv": "npm run build && node open-tv.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "animejs": "^4.3.6",
    "lucide-react": "^0.487.0",
    "pusher-js": "^8.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "cross-env": "^10.0.0",
    "typescript": "^5.9.0",
    "vite": "^6.3.5"
  }
}
